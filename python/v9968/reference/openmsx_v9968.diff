+			// clip
+			int srcX = 0;		// src X
+			int dstX = si.x;	// dst X
+			int nx = si.mgx;	// width
+			if (dstX < minX) {
+				int invalid = minX - dstX;
+				dstX = minX;
+				srcX = invalid;
+				nx -= invalid;
+				if (nx <= 0) {

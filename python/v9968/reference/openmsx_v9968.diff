+			} else {
+				ADY += TY;
+			}
+			ADX = DX;
+			ANX = tmpNX;
+			if (tmpNX <= 0) {
+				commandDone(calculator.getTime());
+				break;
+			}
+		}
+		dstAddr = Mode::addressOf(ADX, ADY, vdp.isEVR(), dstExt);
+		calculator.next(Delta::D1);
+		goto loop;
+	}
+	default:
+		UNREACHABLE;
+	}
+	engineTime = calculator.getTime();
+	this->calcFinishTime(tmpNX, tmpNY, 64 + 32 + 24);
+}

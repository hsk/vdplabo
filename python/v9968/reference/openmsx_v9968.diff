+		ticks += tab[ticks % TICKS] + V9968_MEMORY_ACCESS_TIME + 1;	// read
+	} else if(penalty == VDPCmdCache::CachePenalty::CACHE_WRITE_HIT) {
+		ticks += 1;													// check
